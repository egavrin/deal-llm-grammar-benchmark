root ::= "// @deal-version 1.2" | version-directive ws program | program
program ::= ws import-declaration* top-level-declaration* ws

version-directive ::= "// @deal-version 1.2" line-ending
jsonable-directive ::= "// @jsonable" line-ending
line-ending ::= "\n" | "\r\n" | "\r"

top-level-declaration ::= function-declaration | class-declaration | export-function-declaration | export-class-declaration | jsonable-export-class-declaration

import-declaration ::= "import" sp "*" ws "as" sp identifier sp "from" sp string-literal ws ";" ws
export-function-declaration ::= "export" sp function-declaration
export-class-declaration ::= "export" sp class-declaration
jsonable-export-class-declaration ::= jsonable-directive ws "export" sp class-declaration

class-declaration ::= "class" sp identifier ws "{" ws class-field* "}" ws
class-field ::= required-class-field | optional-class-field
required-class-field ::= identifier ws ":" ws type ws "=" ws expression ws ";" ws
optional-class-field ::= identifier ws "?" ws ":" ws type ws ";" ws

function-declaration ::= async-marker? "function" sp identifier ws "(" ws parameter-list? ")" ws ":" ws type ws block
async-marker ::= "async" sp
parameter-list ::= parameter (ws "," ws parameter)*
parameter ::= identifier ws ":" ws type

block ::= "{" ws statement* "}" ws
statement ::= class-declaration | function-declaration | variable-declaration | return-statement | if-statement | while-statement | for-statement | for-of-statement | break-statement | continue-statement | delete-statement | try-statement | throw-statement | block | expression-statement
variable-declaration ::= "let" sp identifier (ws ":" ws type)? ws "=" ws expression ws ";" ws
return-statement ::= "return" (sp expression)? ws ";" ws
if-statement ::= "if" ws "(" ws expression ws ")" ws block ("else" ws (if-statement | block))?
while-statement ::= "while" ws "(" ws expression ws ")" ws block
for-statement ::= "for" ws "(" ws for-init? ws ";" ws expression? ws ";" ws for-update? ws ")" ws block
for-of-statement ::= "for" ws "(" ws "let" sp identifier ws ":" ws type sp "of" sp expression ws ")" ws block
for-init ::= "let" sp identifier (ws ":" ws type)? ws "=" ws expression | for-update
for-update ::= left-hand-side ws "=" ws assignment-expression
break-statement ::= "break" ws ";" ws
continue-statement ::= "continue" ws ";" ws
delete-statement ::= "delete" sp delete-target ws ";" ws
delete-target ::= postfix-expression (member-part | index-part)
try-statement ::= "try" ws block "catch" ws "(" ws identifier ws ")" ws block
throw-statement ::= "throw" sp expression ws ";" ws
expression-statement ::= expression ws ";" ws

type ::= "null" | non-null-type (sp "|" sp "null")?
non-null-type ::= function-type | array-type
function-type ::= async-marker? "(" ws function-type-parameter-list? ")" ws "=>" ws type
function-type-parameter-list ::= function-type-parameter (ws "," ws function-type-parameter)*
function-type-parameter ::= identifier ws ":" ws type
array-type ::= primary-type (ws "[" ws "]")*
primary-type ::= builtin-type | qualified-type | "(" ws type ws ")"
builtin-type ::= "boolean" | "int" | "number" | "string" | "bytes" | "table" | "Error"
qualified-type ::= identifier ("." identifier)*

expression ::= assignment-expression
assignment-expression ::= left-hand-side ws "=" ws assignment-expression | logical-or-expression
logical-or-expression ::= logical-and-expression (ws "||" ws logical-and-expression)*
logical-and-expression ::= equality-expression (ws "&&" ws equality-expression)*
equality-expression ::= relational-expression (ws equality-operator ws relational-expression)?
equality-operator ::= "===" | "!=="
relational-expression ::= additive-expression (ws relational-operator ws additive-expression)?
relational-operator ::= "<=" | ">=" | "<" | ">"
additive-expression ::= multiplicative-expression (ws additive-operator ws multiplicative-expression)*
additive-operator ::= "+" | "-"
multiplicative-expression ::= exponentiation-expression (ws multiplicative-operator ws exponentiation-expression)*
multiplicative-operator ::= "*" | "/" | "%"
exponentiation-expression ::= unary-expression (ws "**" ws exponentiation-expression)?
unary-expression ::= "-" ws "2147483648" | unary-operator ws unary-expression | await-expression | postfix-expression
unary-operator ::= "!" | "-"
await-expression ::= "await" sp postfix-expression

left-hand-side ::= identifier | generated-reference | postfix-expression (member-part | generated-member-part | index-part)
postfix-expression ::= primary-expression postfix-part*
postfix-part ::= member-part | generated-member-part | index-part | arguments
member-part ::= ws "." ws identifier
generated-member-part ::= ws "." ws generated-reference
index-part ::= ws "[" ws expression ws "]"
arguments ::= ws "(" ws argument-list? ")"
argument-list ::= expression (ws "," ws expression)*

primary-expression ::= null-literal | boolean-literal | number-literal | string-literal | template-literal | identifier | generated-reference | parenthesized-expression | array-literal | object-literal | function-expression | has-expression
parenthesized-expression ::= "(" ws expression ws ")"
null-literal ::= "null"
boolean-literal ::= "true" | "false"
number-literal ::= decimal-number | exponent-number | int-literal
int-literal ::= "0"+ int-nonzero? | int-nonzero
int-nonzero ::= [1-9] | [1-9] [0-9]{1,8} | "1" [0-9]{9} | "20" [0-9]{8} | "21" [0-3] [0-9]{7} | "214" [0-6] [0-9]{6} | "2147" [0-3] [0-9]{5} | "21474" [0-7] [0-9]{4} | "214748" [0-2] [0-9]{3} | "2147483" [0-5] [0-9]{2} | "21474836" [0-3] [0-9] | "214748364" [0-7]
decimal-number ::= ([0-9]* "." [0-9]+) exponent-part?
exponent-number ::= [0-9]+ exponent-part
exponent-part ::= [eE] [+-]? [0-9]+
string-literal ::= "\"" string-character* "\""
string-character ::= [^"\\\r\n] | "\\" [nt\\"']

template-literal ::= "`" template-body
template-body ::= "`" | template-character template-body | "${" ws expression ws "}" template-body | "$" template-after-dollar
template-after-dollar ::= "`" | template-character template-body | "$" template-after-dollar
template-character ::= [^`$\\\r\n] | "\\" [nt\\"'`$]

array-literal ::= "[" ws element-list? ws "]"
element-list ::= expression (ws "," ws expression)*
object-literal ::= "{" ws property-list? ws "}"
property-list ::= property (ws "," ws property)*
property ::= identifier ws ":" ws expression
function-expression ::= async-marker? "function" ws "(" ws parameter-list? ")" ws ":" ws type ws block
has-expression ::= "has" ws "(" ws postfix-expression member-part ws ")"

generated-reference ::= identifier "$fromJson" | identifier "$toJson"

identifier ::= [ABCDEFGHIJKLMNOPQRSTUVWXYZgjkmpqsuvxyz_] identifier-rest* | "a" identifier-a | "b" identifier-b | "c" identifier-c | "d" identifier-d | "e" identifier-e | "f" identifier-f | "h" identifier-h | "i" identifier-i | "l" identifier-l | "n" identifier-n | "o" identifier-o | "r" identifier-r | "t" identifier-t | "w" identifier-w
identifier-rest ::= [A-Za-z0-9_]
identifier-a ::= "" | [ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrtuvxyz0123456789_] identifier-rest* | "s" identifier-a-s | "w" identifier-a-w
