identifier-w-h-i ::= "" | [ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz0123456789_] identifier-rest* | "l" identifier-w-h-i-l
identifier-w-h-i-l ::= "" | [ABCDEFGHIJKLMNOPQRSTUVWXYZabcdfghijklmnopqrstuvwxyz0123456789_] identifier-rest* | "e" identifier-w-h-i-l-e
identifier-w-h-i-l-e ::= [ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_] identifier-rest*

sp ::= [ \t\r\n]+
ws ::= [ \t\r\n]*
