import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

export function main(): null {
  if (candidate.sumThrough(-1) !== oracle.sumThrough(-1)) {
    throw { code: "DIFF", message: "sumThrough" };
  }
  if (candidate.sumThrough(0) !== oracle.sumThrough(0)) {
    throw { code: "DIFF", message: "sumThrough" };
  }
  if (candidate.sumThrough(1) !== oracle.sumThrough(1)) {
    throw { code: "DIFF", message: "sumThrough" };
  }
  if (candidate.sumThrough(10) !== oracle.sumThrough(10)) {
    throw { code: "DIFF", message: "sumThrough" };
  }
  if (candidate.sumThrough(100) !== oracle.sumThrough(100)) {
    throw { code: "DIFF", message: "sumThrough" };
  }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
