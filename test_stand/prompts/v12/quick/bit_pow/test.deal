import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

export function main(): null {
  if (candidate.integerPower(2, 10) !== oracle.integerPower(2, 10)) {
    throw { code: "DIFF", message: "integerPower" };
  }
  if (candidate.integerPower(0, 0) !== oracle.integerPower(0, 0)) {
    throw { code: "DIFF", message: "integerPower" };
  }
  if (candidate.integerPower(0, 3) !== oracle.integerPower(0, 3)) {
    throw { code: "DIFF", message: "integerPower" };
  }
  if (candidate.integerPower(-2, 3) !== oracle.integerPower(-2, 3)) {
    throw { code: "DIFF", message: "integerPower" };
  }
  if (candidate.integerPower(-2, 4) !== oracle.integerPower(-2, 4)) {
    throw { code: "DIFF", message: "integerPower" };
  }
  if (candidate.integerPower(7, 0) !== oracle.integerPower(7, 0)) {
    throw { code: "DIFF", message: "integerPower" };
  }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
