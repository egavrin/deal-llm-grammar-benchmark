import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

export function main(): null {
  if (candidate.hypotenuse(3.0, 4.0) !== oracle.hypotenuse(3.0, 4.0)) {
    throw { code: "DIFF", message: "hypotenuse" };
  }
  if (candidate.hypotenuse(0.0, 0.0) !== oracle.hypotenuse(0.0, 0.0)) {
    throw { code: "DIFF", message: "hypotenuse" };
  }
  if (candidate.hypotenuse(-5.0, 12.0) !== oracle.hypotenuse(-5.0, 12.0)) {
    throw { code: "DIFF", message: "hypotenuse" };
  }
  if (candidate.hypotenuse(1.0, 1.0) !== oracle.hypotenuse(1.0, 1.0)) {
    throw { code: "DIFF", message: "hypotenuse" };
  }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
