import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

export function main(): null {
  let bounds: int[][] = [[1, 3], [2, 2], [3, 1], [-2, 1]];
  for (let pair: int[] of bounds) {
    let mine: int[] = [];
    let theirs: int[] = [];
    let myResult: null = candidate.emitRange(pair[0], pair[1], function(value: int): null {
      mine[mine.length] = value; return null;
    });
    let theirResult: null = oracle.emitRange(pair[0], pair[1], function(value: int): null {
      theirs[theirs.length] = value; return null;
    });
    if (myResult !== theirResult || mine.length !== theirs.length) {
      throw { code: "DIFF", message: "emitRange length or result" };
    }
    let i: int = 0;
    while (i < mine.length) {
      if (mine[i] !== theirs[i]) { throw { code: "DIFF", message: "emitRange order" }; }
      i = i + 1;
    }
  }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
