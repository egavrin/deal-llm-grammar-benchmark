import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

export function main(): null {
  if (candidate.circleAreaLabel(0.0) !== oracle.circleAreaLabel(0.0)) {
    throw { code: "DIFF", message: "circleAreaLabel" };
  }
  if (candidate.circleAreaLabel(1.0) !== oracle.circleAreaLabel(1.0)) {
    throw { code: "DIFF", message: "circleAreaLabel" };
  }
  if (candidate.circleAreaLabel(2.0) !== oracle.circleAreaLabel(2.0)) {
    throw { code: "DIFF", message: "circleAreaLabel" };
  }
  if (candidate.circleAreaLabel(0.5) !== oracle.circleAreaLabel(0.5)) {
    throw { code: "DIFF", message: "circleAreaLabel" };
  }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
