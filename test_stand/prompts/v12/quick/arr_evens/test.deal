import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

export function main(): null {
  if (candidate.commaSeparatedEvens([]) !== oracle.commaSeparatedEvens([])) {
    throw { code: "DIFF", message: "commaSeparatedEvens" };
  }
  if (candidate.commaSeparatedEvens([1, 3]) !== oracle.commaSeparatedEvens([1, 3])) {
    throw { code: "DIFF", message: "commaSeparatedEvens" };
  }
  if (candidate.commaSeparatedEvens([1, 2, 3, 4, 5, 6]) !== oracle.commaSeparatedEvens([1, 2, 3, 4, 5, 6])) {
    throw { code: "DIFF", message: "commaSeparatedEvens" };
  }
  if (candidate.commaSeparatedEvens([0, -2, -3, 4]) !== oracle.commaSeparatedEvens([0, -2, -3, 4])) {
    throw { code: "DIFF", message: "commaSeparatedEvens" };
  }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
