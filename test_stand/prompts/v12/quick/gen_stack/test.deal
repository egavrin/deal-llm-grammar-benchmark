import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

export function main(): null {
  let mine: candidate.IntStack = {};
  let theirs: oracle.IntStack = {};
  let untouched: candidate.IntStack = {};
  if (candidate.stackPop(mine) !== oracle.stackPop(theirs)) {
    throw { code: "DIFF", message: "stackPop empty" };
  }
  for (let value: int of [1, -2, 3]) {
    let a: null = candidate.stackPush(mine, value);
    let b: null = oracle.stackPush(theirs, value);
    if (a !== b) { throw { code: "DIFF", message: "stackPush return" }; }
  }
  let i: int = 0;
  while (i < 4) {
    if (candidate.stackPop(mine) !== oracle.stackPop(theirs) || mine.items.length !== theirs.items.length) {
      throw { code: "DIFF", message: "stackPop order" };
    }
    i = i + 1;
  }
  if (untouched.items.length !== 0) { throw { code: "DIFF", message: "stack independence" }; }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
