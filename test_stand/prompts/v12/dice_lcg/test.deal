import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

function sameList(a: int[], b: int[], what: string): null {
  if (a.length !== b.length) {
    throw { code: "DIFF", message: what };
  }
  for (let i: int = 0; i < a.length; i = i + 1) {
    if (a[i] !== b[i]) {
      throw { code: "DIFF", message: what };
    }
  }
  return null;
}

export function main(): null {
  for (let seed: int of [0, 1, 42, 65536, 12345]) {
    if (candidate.nextSeed(seed) !== oracle.nextSeed(seed)) {
      throw { code: "DIFF", message: "nextSeed" };
    }
    if (candidate.rollFrom(seed) !== oracle.rollFrom(seed)) {
      throw { code: "DIFF", message: "rollFrom" };
    }
    for (let count: int of [0, 1, 5, -3]) {
      sameList(candidate.rollMany(seed, count), oracle.rollMany(seed, count), "rollMany");
      if (candidate.totalOf(seed, count) !== oracle.totalOf(seed, count)) {
        throw { code: "DIFF", message: "totalOf" };
      }
    }
  }
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
