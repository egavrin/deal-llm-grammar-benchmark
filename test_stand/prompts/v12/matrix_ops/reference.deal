export function identity(n: int): int[][] {
  let rows: int[][] = [];
  for (let i: int = 0; i < n; i = i + 1) {
    let row: int[] = [];
    for (let j: int = 0; j < n; j = j + 1) {
      if (i === j) {
        row[row.length] = 1;
      } else {
        row[row.length] = 0;
      }
    }
    rows[rows.length] = row;
  }
  return rows;
}

export function transpose(m: int[][]): int[][] {
  let result: int[][] = [];
  if (m.length === 0) {
    return result;
  }
  let width: int = m[0].length;
  for (let j: int = 0; j < width; j = j + 1) {
    let column: int[] = [];
    for (let i: int = 0; i < m.length; i = i + 1) {
      column[column.length] = m[i][j];
    }
    result[result.length] = column;
  }
  return result;
}

export function rowSums(m: int[][]): int[] {
  let sums: int[] = [];
  for (let row: int[] of m) {
    let total: int = 0;
    for (let value: int of row) {
      total = total + value;
    }
    sums[sums.length] = total;
  }
  return sums;
}

export function trace(m: int[][]): int {
  let total: int = 0;
  for (let i: int = 0; i < m.length; i = i + 1) {
    if (i < m[i].length) {
      total = total + m[i][i];
    }
  }
  return total;
}
