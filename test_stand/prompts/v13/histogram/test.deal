import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

function sameList(a: int[], b: int[], what: string): null {
  if (a.length !== b.length) {
    throw { code: "DIFF", message: what };
  }
  for (let i: int = 0; i < a.length; i = i + 1) {
    if (a[i] !== b[i]) {
      throw { code: "DIFF", message: what };
    }
  }
  return null;
}

function check(values: int[]): null {
  for (let size: int of [0, 1, 3, 10]) {
    sameList(candidate.bucketCounts(values, size), oracle.bucketCounts(values, size), "bucketCounts");
    if (candidate.largestBucket(values, size) !== oracle.largestBucket(values, size)) {
      throw { code: "DIFF", message: "largestBucket" };
    }
  }
  if (candidate.mode(values) !== oracle.mode(values)) {
    throw { code: "DIFF", message: "mode" };
  }
  return null;
}

export function main(): null {
  let none: int[] = [];
  check(none);
  check([0]);
  check([4, 4, 9, 1]);
  check([12, 3, 3, 12, 7]);
  check([30, 0, 15, 15, 31]);
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
