export function filled(size: int, value: int): bytes {
  let data: bytes = bytes(size);
  let i: int = 0;
  while (i < size) {
    data[i] = value;
    i = i + 1;
  }
  return data;
}

export function byteSum(data: bytes): int {
  let total: int = 0;
  let i: int = 0;
  while (i < data.length) {
    total = total + data[i];
    i = i + 1;
  }
  return total;
}

export function checksum(data: bytes): int {
  return byteSum(data) % 256;
}

export function countByte(data: bytes, value: int): int {
  let count: int = 0;
  let i: int = 0;
  while (i < data.length) {
    if (data[i] === value) {
      count = count + 1;
    }
    i = i + 1;
  }
  return count;
}

export function isZero(data: bytes): boolean {
  let i: int = 0;
  while (i < data.length) {
    if (data[i] !== 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}
