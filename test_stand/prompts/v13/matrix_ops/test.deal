import * as candidate from "./solution";
import * as oracle from "./reference";
import * as console from "std/console";

function sameMatrix(a: int[][], b: int[][], what: string): null {
  if (a.length !== b.length) {
    throw { code: "DIFF", message: what };
  }
  for (let i: int = 0; i < a.length; i = i + 1) {
    if (a[i].length !== b[i].length) {
      throw { code: "DIFF", message: what };
    }
    for (let j: int = 0; j < a[i].length; j = j + 1) {
      if (a[i][j] !== b[i][j]) {
        throw { code: "DIFF", message: what };
      }
    }
  }
  return null;
}

function sameList(a: int[], b: int[], what: string): null {
  if (a.length !== b.length) {
    throw { code: "DIFF", message: what };
  }
  for (let i: int = 0; i < a.length; i = i + 1) {
    if (a[i] !== b[i]) {
      throw { code: "DIFF", message: what };
    }
  }
  return null;
}

function check(m: int[][]): null {
  sameMatrix(candidate.transpose(m), oracle.transpose(m), "transpose");
  sameList(candidate.rowSums(m), oracle.rowSums(m), "rowSums");
  if (candidate.trace(m) !== oracle.trace(m)) {
    throw { code: "DIFF", message: "trace" };
  }
  return null;
}

export function main(): null {
  for (let n: int of [0, 1, 3, -1]) {
    sameMatrix(candidate.identity(n), oracle.identity(n), "identity");
  }
  let empty: int[][] = [];
  check(empty);
  check([[7]]);
  check([[1, 2, 3], [4, 5, 6]]);
  check([[1, 2], [3, 4], [5, 6]]);
  check([[2, 0, 0], [0, 3, 0], [0, 0, 4]]);
  console.log("__DEAL_BENCH_PASS__");
  return null;
}
